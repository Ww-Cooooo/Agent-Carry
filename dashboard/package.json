{
  "name": "agent-carry-dashboard",
  "private": true,
  "version": "1.1.1",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check:actions": "node scripts/validate-action-mirror.mjs",
    "check:first-run": "node scripts/validate-first-run-contract.mjs",
    "licenses:generate": "node scripts/generate-third-party-notices.mjs",
    "check:licenses": "node scripts/generate-third-party-notices.mjs --check",
    "check:compliance": "node scripts/validate-open-source-compliance.mjs",
    "check:offline": "node scripts/validate-offline-assets.mjs",
    "build": "npm run check:actions && npm run check:first-run && npm run check:licenses && npm run check:compliance && tsc -b && vite build && node scripts/make-offline.mjs && npm run check:offline",
    "analyze": "vite build --mode analyze",
    "preview": "vite preview"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lenis": "^1.3.26",
    "lucide-react": "^1.31.0",
    "motion": "^12.0.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^6.0.4",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
